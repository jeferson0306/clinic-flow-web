# ── clinic-flow API ──────────────────────────────────────────────
# Server-side only — the browser never talks to clinic-flow directly, only
# to this app's own Route Handlers/Server Actions (see lib/api.ts). That is
# what keeps the JWT in an httpOnly cookie instead of client-side JS.
CLINIC_FLOW_API_URL=http://localhost:8080

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=clinic-flow

# ── Sentry ────────────────────────────────────────────────────────
# The same DSN in both — NEXT_PUBLIC_SENTRY_DSN is read by
# instrumentation-client.ts (the browser bundle), SENTRY_DSN by
# sentry.server.config.ts/sentry.edge.config.ts (server/edge runtimes,
# which don't need the NEXT_PUBLIC_ prefix since they never ship to the
# browser). A DSN is designed to be public — it can only submit events.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
