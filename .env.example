# ── clinic-flow API ──────────────────────────────────────────────
# Server-side only — the browser never talks to clinic-flow directly, only
# to this app's own Route Handlers/Server Actions (see lib/api.ts). That is
# what keeps the JWT in an httpOnly cookie instead of client-side JS.
CLINIC_FLOW_API_URL=http://localhost:8080

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=clinic-flow
